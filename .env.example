CHATANYWHERE_BASE_URL=https://api.chatanywhere.org
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

WEB2KG_CHAT_PROVIDER=CHATANYWHERE
